---
import type { Language } from '@/i18n/config'
import { getTagPath } from '@/i18n/path'

interface Props {
  tags: string[]
  currentTag?: string
  lang: Language
}

const { tags, currentTag = '', lang } = Astro.props
---

<div class="no-heti tag-list">
  {tags.map(tag => (
    <a
      href={getTagPath(tag, lang)}
      class:list={['tag', { 'is-current': currentTag === tag }]}
    >
      {tag}
    </a>
  ))}
</div>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.42rem 0.8rem;
    border: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.22);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 450;
    letter-spacing: 0.01em;
    color: oklch(var(--un-preset-theme-colors-secondary));
    text-decoration: none;
    transition:
      color 0.16s ease-out,
      border-color 0.16s ease-out,
      background-color 0.16s ease-out;
  }
  .tag::before {
    content: "#";
    margin-right: 0.12em;
    color: oklch(var(--un-preset-theme-colors-accent));
  }

  .tag:hover {
    color: oklch(var(--un-preset-theme-colors-primary));
    border-color: oklch(var(--un-preset-theme-colors-accent) / 0.55);
  }
  .tag.is-current {
    color: oklch(var(--un-preset-theme-colors-accent));
    border-color: oklch(var(--un-preset-theme-colors-accent) / 0.55);
    background: oklch(var(--un-preset-theme-colors-accent) / 0.08);
  }
  .tag.is-current::before {
    color: oklch(var(--un-preset-theme-colors-accent));
  }
</style>
