---
import type { Language } from '@/i18n/config'
import { getTagPath } from '@/i18n/path'

interface Props {
  /** Plain tag names, or [tag, postCount] pairs to show weighting. */
  tags: string[] | [string, number][]
  currentTag?: string
  lang: Language
}

const { tags, currentTag = '', lang } = Astro.props

const entries: [string, number | null][] = tags.map(tag =>
  Array.isArray(tag) ? [tag[0], tag[1]] : [tag, null],
)
---

<div class="no-heti tag-list">
  {entries.map(([tag, count]) => (
    <a
      href={getTagPath(tag, lang)}
      class:list={['tag', { 'is-current': currentTag === tag }]}
    >
      {tag}
      {count !== null && <span class="tag-count">{count}</span>}
    </a>
  ))}
</div>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.42rem 0.8rem;
    border: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.22);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 450;
    letter-spacing: 0.01em;
    color: oklch(var(--un-preset-theme-colors-secondary));
    text-decoration: none;
    transition:
      color 0.16s ease-out,
      border-color 0.16s ease-out,
      background-color 0.16s ease-out;
  }
  .tag::before {
    content: "#";
    margin-right: 0.12em;
    color: oklch(var(--un-preset-theme-colors-accent));
  }

  /* Counts turn an undifferentiated cloud into something you can read the
     shape of — which subjects recur, and which were written about once. */
  .tag-count {
    margin-left: 0.5em;
    padding-left: 0.5em;
    border-left: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.22);
    font-size: 0.92em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
  }
  .tag:hover .tag-count,
  .tag.is-current .tag-count {
    border-color: oklch(var(--un-preset-theme-colors-accent) / 0.4);
  }

  .tag:hover {
    color: oklch(var(--un-preset-theme-colors-primary));
    border-color: oklch(var(--un-preset-theme-colors-accent) / 0.55);
  }
  .tag.is-current {
    color: oklch(var(--un-preset-theme-colors-accent));
    border-color: oklch(var(--un-preset-theme-colors-accent) / 0.55);
    background: oklch(var(--un-preset-theme-colors-accent) / 0.08);
  }
  .tag.is-current::before {
    color: oklch(var(--un-preset-theme-colors-accent));
  }
</style>
