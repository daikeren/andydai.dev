---
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

const { currentLang, isHome, isPost, isTag, isAbout, getLocalizedPath } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}

const navItems = [
  { href: '/', label: currentUI.posts, active: isHome || isPost },
  { href: '/tags/', label: currentUI.tags, active: isTag },
  { href: '/about/', label: currentUI.about, active: isAbout },
]
---

<nav aria-label="Site Navigation" class="site-nav cjk:tracking-wide">
  <ul>
    {navItems.map(item => (
      <li>
        <a
          href={getLocalizedPath(item.href)}
          class="nav-link"
          class:list={[{ 'is-active': item.active }]}
          aria-current={item.active ? 'page' : undefined}
        >
          <span class="nav-mark" aria-hidden="true"></span>
          <span class="nav-text">{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .site-nav ul {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    --mark: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    /* Padding (offset by negative margin) enlarges the tap target
       without changing the visual rhythm. */
    padding-block: 0.6rem;
    margin-block: -0.6rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: oklch(var(--un-preset-theme-colors-secondary));
    text-decoration: none;
    transition: color 0.18s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-mark {
    width: 0.5rem;
    height: 2px;
    border-radius: 1px;
    background: oklch(var(--un-preset-theme-colors-accent));
    transform: scaleX(var(--mark));
    transform-origin: left center;
    opacity: var(--mark);
    transition:
      transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-link:hover {
    color: oklch(var(--un-preset-theme-colors-primary));
    --mark: 1;
  }

  .nav-link.is-active {
    color: oklch(var(--un-preset-theme-colors-primary));
    font-weight: 600;
    --mark: 1;
  }

  /* Desktop rail: stacked, generous, with the marker doubling as a left tick */
  @media (min-width: 1024px) {
    .site-nav ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.65rem;
    }
    .nav-link {
      font-size: 1rem;
      gap: 0.55rem;
    }
    .nav-mark {
      width: 0.7rem;
    }
  }

  :global(.reduce-motion) .nav-mark {
    transition: none;
  }
</style>
