---
import type { Language } from '@/i18n/config'
import LanguageSwitcherIcon from '@/assets/icons/language-switcher.svg'
import { moreLocales } from '@/config'
import { getNextGlobalLangPath, getNextSupportedLangPath } from '@/i18n/path'

interface Props {
  supportedLangs: Language[]
}

const { supportedLangs } = Astro.props
const currentPath = Astro.url.pathname

// Check if there are other languages to switch
const showLanguageSwitcher = moreLocales.length > 0
// Choose a language switch list according to supported languages
const nextUrl = supportedLangs.length > 0
  ? getNextSupportedLangPath(currentPath, supportedLangs) // Use supported languages when available
  : getNextGlobalLangPath(currentPath) // Fallback to all languages when no supported languages data
---

{showLanguageSwitcher && (
  <div class="site-controls">
    <a
      id="language-switcher"
      href={nextUrl}
      class="control-btn"
      aria-label="Switch website language"
    >
      <LanguageSwitcherIcon
        aria-hidden="true"
        fill="currentColor"
      />
    </a>
  </div>
)}

<style>
  .site-controls {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  /* Icon stays icon-sized in layout; an invisible centered overlay
     gives a 44px touch target without shifting anything. */
  .control-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.05rem;
    height: 1.05rem;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    color: oklch(var(--un-preset-theme-colors-secondary));
    transition:
      color 0.18s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .control-btn::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    transform: translate(-50%, -50%);
  }

  .control-btn:hover {
    color: oklch(var(--un-preset-theme-colors-accent));
  }

  .control-btn:active {
    transform: scale(0.9);
  }

  .control-btn :global(svg) {
    width: 100%;
    height: 100%;
  }

  :global(.reduce-motion) .control-btn {
    transition-property: color;
  }
</style>
