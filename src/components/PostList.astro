---
import type { Language } from '@/i18n/config'
import type { Post } from '@/types'
import PinIcon from '@/assets/icons/pin-icon.svg'
import PostDate from '@/components/PostDate.astro'
import { getPostPath } from '@/i18n/path'
import { getPostDescription } from '@/utils/description'
import { isHomePage } from '@/utils/page'

export interface Props {
  posts: Post[]
  lang: Language
  pinned?: boolean
}

const { posts, lang, pinned = false } = Astro.props
const isHome = isHomePage(Astro.url.pathname)
---

<ul class="post-list">
  {posts.map((post) => {
    const slug = post.data.abbrlink || post.id

    return (
      <li class="post-row">
        <a
          class="post-row-link"
          href={getPostPath(slug, lang)}
          transition:name={`post-${slug}${lang ? `-${lang}` : ''}`}
          data-disable-theme-toggle-transition
        >
          <span class="post-row-meta font-time">
            <PostDate
              date={post.data.published}
              minutes={post.remarkPluginFrontmatter.minutes}
            />
          </span>

          <span class="post-row-body">
            <span class="post-row-title cjk:tracking-wide">
              {post.data.title}
              {pinned && (
                <PinIcon
                  aria-hidden="true"
                  class="post-row-pin"
                  fill="currentColor"
                />
              )}
            </span>
            {isHome && (
              <span class="post-row-desc">{getPostDescription(post, 'list')}</span>
            )}
          </span>
        </a>
      </li>
    )
  })}
</ul>

<style>
  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-row + .post-row {
    margin-top: 1.6rem;
  }

  .post-row-link {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.3rem 1.4rem;
    text-decoration: none;
    color: inherit;
  }

  /* Mono metadata: date over reading-time, quiet */
  .post-row-meta {
    font-size: 0.72rem;
    line-height: 1.5;
    letter-spacing: 0.01em;
    color: var(--ink-muted);
    transition: color 0.18s ease-out;
  }
  .post-row-meta :global(time),
  .post-row-meta :global(span) {
    display: inline;
    margin: 0;
  }
  .post-row-meta :global(span) {
    margin-left: 0.7rem;
  }

  .post-row-title {
    font-size: 1.06rem;
    font-weight: 600;
    line-height: 1.4;
    color: oklch(var(--un-preset-theme-colors-primary));
    text-wrap: pretty;
    transition: color 0.18s ease-out;
  }

  .post-row-pin {
    display: inline-block;
    width: 0.85em;
    height: 0.85em;
    margin-left: 0.3em;
    transform: translateY(-0.05em);
    color: oklch(var(--un-preset-theme-colors-accent));
  }

  .post-row-desc {
    display: none;
    margin-top: 0.45rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: oklch(var(--un-preset-theme-colors-secondary));
    text-wrap: pretty;
  }

  .post-row-link:hover .post-row-title {
    color: oklch(var(--un-preset-theme-colors-accent));
  }
  .post-row-link:hover .post-row-meta {
    color: oklch(var(--un-preset-theme-colors-secondary));
  }

  /* Desktop: aligned mono metadata column beside the title block */
  @media (min-width: 1024px) {
    .post-row + .post-row {
      margin-top: 2rem;
    }
    .post-row-link {
      grid-template-columns: 5rem 1fr;
      align-items: baseline;
    }
    .post-row-meta :global(time),
    .post-row-meta :global(span) {
      display: block;
    }
    .post-row-meta :global(span) {
      margin-left: 0;
      margin-top: 0.2rem;
    }
    .post-row-title {
      font-size: 1.12rem;
    }
    .post-row-desc {
      display: block;
    }
  }
</style>
