---
/**
 * FAQ - 視覺化的常見問題組件
 * 在文章底部顯示 FAQ，同時 Schema 由 ArticleSchema 組件處理
 */
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

interface FAQ {
  question: string
  answer: string
}

interface Props {
  faqs: FAQ[]
}

const { faqs } = Astro.props
const { currentLang } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? ui['en']
---

{faqs.length > 0 && (
  <section class="faq-section">
    <h2 class="faq-heading">{currentUI.faq}</h2>
    <div class="faq-list">
      {faqs.map((faq, index) => (
        <details class="faq-item" open={index === 0}>
          <summary class="faq-question">
            <span class="faq-marker" aria-hidden="true">Q</span>
            <span class="faq-q-text">{faq.question}</span>
          </summary>
          <div class="faq-answer">
            <span class="faq-marker faq-marker-a" aria-hidden="true">A</span>
            <span>{faq.answer}</span>
          </div>
        </details>
      ))}
    </div>
  </section>
)}

<style>
  .faq-section {
    margin-top: 3.25rem;
  }

  .faq-heading {
    margin: 0 0 1.4rem;
    font-size: 1.42rem;
    font-weight: 700;
    letter-spacing: -0.012em;
    color: oklch(var(--un-preset-theme-colors-primary));
  }

  .faq-item {
    padding: 1rem 0;
    border-top: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.14);
  }
  .faq-item:last-child {
    border-bottom: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.14);
  }

  .faq-question {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: oklch(var(--un-preset-theme-colors-primary));
  }
  .faq-question::-webkit-details-marker {
    display: none;
  }
  .faq-question::before {
    display: none;
  }

  .faq-marker {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: oklch(var(--un-preset-theme-colors-accent));
  }
  .faq-marker-a {
    color: var(--ink-muted);
  }

  .faq-answer {
    display: flex;
    gap: 0.65rem;
    margin-top: 0.8rem;
    color: oklch(var(--un-preset-theme-colors-secondary));
  }
</style>
