---
/**
 * AboutPersonSchema - About 頁的 Person 結構化資料
 */
import { themeConfig } from '@/config'
import { PERSON_ID, personSameAs } from '@/utils/schema'

interface Props {
  profileUrl: string
  description: string
}

const { profileUrl, description } = Astro.props
const { author } = themeConfig.site

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': PERSON_ID,
  'name': author,
  'url': profileUrl,
  'description': description,
  'sameAs': personSameAs(),
}
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
