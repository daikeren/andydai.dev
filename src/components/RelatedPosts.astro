---
import type { Language } from '@/i18n/config'
import type { Post } from '@/types'
import { getPostPath } from '@/i18n/path'
import { ui } from '@/i18n/ui'

interface Props {
  posts: Post[]
  lang: Language
}

const { posts, lang } = Astro.props
const currentUI = ui[lang as keyof typeof ui] ?? {}
---

{posts.length > 0 && (
  <nav class="read-next no-heti" aria-label={currentUI.readNext}>
    <h2 class="read-next-label">{currentUI.readNext}</h2>
    <ul class="read-next-list">
      {posts.map((post) => {
        const slug = post.data.abbrlink || post.id
        return (
          <li class="read-next-item">
            <a class="read-next-link" href={getPostPath(slug, lang)}>
              <span class="read-next-title cjk:tracking-wide">{post.data.title}</span>
              <span class="read-next-meta font-time">{post.remarkPluginFrontmatter.minutes} min</span>
            </a>
          </li>
        )
      })}
    </ul>
  </nav>
)}

<style>
  /* A reader who finished a post is the likeliest person to read a second
     one; before this the article ended in a comment box. Deliberately a
     plain list, not cards — it should read as the article's last section,
     not as a recommendation widget bolted underneath it. */
  .read-next {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.16);
  }

  /* A real h2 for the document outline, but it sits inside .heti, which
     decorates every h2 with the section tick. That mark means "article
     section"; this is a navigation label, so it is suppressed here. */
  .read-next-label::before {
    display: none;
  }

  .read-next-label {
    margin: 0 0 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .read-next-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .read-next-item + .read-next-item {
    margin-top: 1.05rem;
  }

  .read-next-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.2rem;
    text-decoration: none;
    color: inherit;
  }

  .read-next-title {
    font-size: 1rem;
    font-weight: 550;
    line-height: 1.5;
    color: oklch(var(--un-preset-theme-colors-primary));
    text-wrap: pretty;
    transition: color 0.18s ease-out;
  }

  .read-next-meta {
    flex: none;
    font-size: 0.72rem;
    color: var(--ink-muted);
    transition: color 0.18s ease-out;
  }

  .read-next-link:hover .read-next-title {
    color: oklch(var(--un-preset-theme-colors-accent));
  }
  .read-next-link:hover .read-next-meta {
    color: oklch(var(--un-preset-theme-colors-secondary));
  }
</style>
