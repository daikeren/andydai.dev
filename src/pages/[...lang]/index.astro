---
import PostList from '@/components/PostList.astro'
import SiteSchema from '@/components/SiteSchema.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'
import { getPinnedPosts, getPostsByYear } from '@/utils/content'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}
const pinnedPosts = await getPinnedPosts(currentLang)
const postsByYear = await getPostsByYear(currentLang)
const homePageTitle = currentLang === 'en'
  ? 'Andy\'s System - AI, Engineering, Startups'
  : `${currentUI.title} - ${currentUI.subtitle}`
---

<Layout
  pageTitle={homePageTitle}
  pageDescription={currentUI.description}
  supportedLangs={allLocales}
>
  <SiteSchema
    siteUrl={new URL(Astro.url.pathname, Astro.url.origin).href}
    name={currentUI.title}
    description={currentUI.description}
    lang={currentLang}
  />
  <div class="index">
    {pinnedPosts.length > 0 && (
      <section class="index-group">
        <PostList posts={pinnedPosts} lang={currentLang} pinned={true} />
      </section>
    )}

    {[...postsByYear.entries()].map(([year, posts]) => (
      <section class="index-group">
        <h2 class="index-year font-time">{year}</h2>
        <PostList posts={posts} lang={currentLang} />
      </section>
    ))}
  </div>
</Layout>

<style>
  .index-group + .index-group {
    margin-top: 3rem;
  }

  .index-year {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.6rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
  }
  .index-year::after {
    content: "";
    flex: 1;
    height: 1px;
    background: oklch(var(--un-preset-theme-colors-secondary) / 0.13);
  }
</style>
