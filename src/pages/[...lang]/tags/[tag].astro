---
import PostList from '@/components/PostList.astro'
import TagList from '@/components/TagList.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'
import { getAllTags, getPostsByTag, getTagSupportedLangs } from '@/utils/content'

export async function getStaticPaths() {
  const paths = await Promise.all(allLocales.map(async (lang) => {
    const langTags = await getAllTags(lang)
    return langTags.map(tag => ({
      params: { lang: getLangRouteParam(lang), tag },
      props: { tag },
    }))
  }))
  return paths.flat()
}

const { tag } = Astro.props
const currentLang = getLangFromLocale(Astro.currentLocale)
const posts = await getPostsByTag(tag, currentLang)
const allTags = await getAllTags(currentLang)
const supportedLangs = await getTagSupportedLangs(tag)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}
const pageDescription = currentLang === 'zh-tw'
  ? `瀏覽 Andy's System 中標記為 ${tag} 的文章，包含 Andy Dai 對 AI 工具實戰、工程團隊管理、developer productivity 與 startup 產品決策的觀察。`
  : `Posts tagged ${tag} on AI engineering, developer productivity, engineering leadership, and startup execution from Andy Dai.`
---

<Layout
  pageTitle={`#${tag} | ${currentUI.title}`}
  pageDescription={pageDescription}
  supportedLangs={supportedLangs}
>
  <header class="page-head">
    <h2 class="page-title">#{tag}</h2>
  </header>

  <!-- Posts List -->
  <PostList
    posts={posts}
    lang={currentLang}
  />

  <!-- Browse other tags -->
  <nav class="other-tags" aria-label="All tags">
    <TagList
      tags={allTags}
      currentTag={tag}
      lang={currentLang}
    />
  </nav>
</Layout>

<style>
  .other-tags {
    margin-top: 3.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.14);
  }
</style>
