---
import TagList from '@/components/TagList.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'
import { getAllTagsWithCount } from '@/utils/content'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const allTags = await getAllTagsWithCount(currentLang)

const currentUI = ui[currentLang as keyof typeof ui] ?? {}
const pageDescription = currentLang === 'zh-tw'
  ? '瀏覽 Andy\'s System 的文章標籤，從 AI 工具實戰、developer productivity、工程團隊管理到 startup 產品決策，快速找到相關主題與系列文章，追蹤 Andy Dai 長期觀察的脈絡。'
  : 'Browse Andy\'s System tags on AI engineering, developer productivity, engineering leadership, and startup execution.'
const intro = currentLang === 'zh-tw'
  ? '用標籤追蹤反覆出現的主題，從 AI 工程、startup 執行，到把新工具放進真實工作流程前需要先想清楚的取捨。'
  : 'Use tags to follow recurring themes across AI engineering, startup execution, and the practical decisions behind adopting new tools.'
---

<Layout
  pageTitle={`${currentUI.tags} | ${currentUI.title}`}
  pageDescription={pageDescription}
  supportedLangs={allLocales}
>
  <header class="page-head">
    <h2 class="page-title">{currentUI.tags}</h2>
    <p class="page-sub">{intro}</p>
  </header>
  <!-- Tag List -->
  <TagList
    tags={allTags}
    lang={currentLang}
  />
</Layout>
