---
import TagList from '@/components/TagList.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'
import { getAllTags } from '@/utils/content'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const allTags = await getAllTags(currentLang)

const currentUI = ui[currentLang as keyof typeof ui] ?? {}
const pageDescription = currentLang === 'zh-tw'
  ? '瀏覽 Andy\'s System 的文章標籤，從 AI 工具實戰、developer productivity、工程團隊管理到 startup 產品決策，快速找到相關主題與系列文章，追蹤 Andy Dai 長期觀察的脈絡。'
  : 'Browse Andy\'s System tags across AI engineering, developer productivity, engineering leadership, startup execution, and the practical trade-offs behind adopting new tools.'
---

<Layout
  pageTitle={`${currentUI.tags} | ${currentUI.title}`}
  pageDescription={pageDescription}
  supportedLangs={allLocales}
>
  <header class="page-head">
    <h2 class="page-title">{currentUI.tags}</h2>
  </header>
  <!-- Tag List -->
  <TagList
    tags={allTags}
    lang={currentLang}
  />
</Layout>
